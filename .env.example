# GOOGLE_PROJECT_ID: Your Google Cloud project ID (found in GCP console)
GOOGLE_PROJECT_ID="my-project-id"

# GOOGLE_LOCATION: Vertex AI region (default: us-central1)
GOOGLE_LOCATION="us-central1"

# GOOGLE_APPLICATION_CREDENTIALS: Path to your service account JSON key file
# Download from GCP Console → APIs & Services → Credentials → Service Account → Keys
# Place the .json file in your project root and set this to its filename
GOOGLE_APPLICATION_CREDENTIALS="credentials.json"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
